{
  "name": "inc0ming",
  "displayName": "Inc0ming",
  "description": "Radar + Todo dashboard powered by markdown files",
  "version": "0.7.0",
  "publisher": "MLLANN01",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MLLANN01/Inc0ming"
  },
  "license": "ISC",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.inc0ming/inc0ming.md"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inc0ming",
          "title": "Inc0ming",
          "icon": "media/inc0ming-icon.svg"
        }
      ]
    },
    "views": {
      "inc0ming": [
        {
          "id": "inc0ming.statusView",
          "name": "Status",
          "type": "webview"
        },
        {
          "id": "inc0ming.radarTree",
          "name": "Radar Swim Lanes",
          "type": "tree"
        },
        {
          "id": "inc0ming.contactsTree",
          "name": "Contacts",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "inc0ming.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addSwimlane",
        "title": "Add Swim Lane",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addRadarItem",
        "title": "Add Radar Item",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addSubGroup",
        "title": "Add Sub-Group",
        "icon": "$(folder-add)",
        "category": "Inc0ming"
      },
{
        "command": "inc0ming.editItem",
        "title": "Edit",
        "icon": "$(edit)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.deleteItem",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Inc0ming"
      },
{
        "command": "inc0ming.expandRadarTree",
        "title": "Expand All",
        "icon": "$(expand-all)",
        "category": "Inc0ming"
      },
{
        "command": "inc0ming.addContactGroup",
        "title": "Add Contact Group",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addContact",
        "title": "Add Contact",
        "icon": "$(person-add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.editContact",
        "title": "Edit Contact",
        "icon": "$(edit)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.deleteContactItem",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Inc0ming"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "inc0ming.refresh",
          "when": "view == inc0ming.statusView",
          "group": "navigation"
        },
        {
          "command": "inc0ming.expandRadarTree",
          "when": "view == inc0ming.radarTree",
          "group": "navigation"
        },
        {
          "command": "inc0ming.addSwimlane",
          "when": "view == inc0ming.radarTree",
          "group": "navigation"
        },
        {
          "command": "inc0ming.addContactGroup",
          "when": "view == inc0ming.contactsTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "inc0ming.addRadarItem",
          "when": "viewItem == swimlane || viewItem == subgroup",
          "group": "inline"
        },
        {
          "command": "inc0ming.deleteItem",
          "when": "viewItem == radarItem",
          "group": "inline"
        },
        {
          "command": "inc0ming.addRadarItem",
          "when": "viewItem == swimlane || viewItem == subgroup",
          "group": "1_add"
        },
        {
          "command": "inc0ming.addSubGroup",
          "when": "viewItem == swimlane",
          "group": "1_add"
        },
        {
          "command": "inc0ming.editItem",
          "when": "viewItem == swimlane || viewItem == subgroup || viewItem == radarItem",
          "group": "2_edit"
        },
        {
          "command": "inc0ming.deleteItem",
          "when": "viewItem == swimlane || viewItem == subgroup || viewItem == radarItem",
          "group": "3_delete"
        },
        {
          "command": "inc0ming.addContact",
          "when": "viewItem == contactGroup",
          "group": "inline"
        },
        {
          "command": "inc0ming.deleteContactItem",
          "when": "viewItem == contact || viewItem == contactGroup",
          "group": "inline"
        },
        {
          "command": "inc0ming.addContact",
          "when": "viewItem == contactGroup",
          "group": "1_add"
        },
        {
          "command": "inc0ming.editContact",
          "when": "viewItem == contact",
          "group": "2_edit"
        },
        {
          "command": "inc0ming.deleteContactItem",
          "when": "viewItem == contact || viewItem == contactGroup",
          "group": "3_delete"
        }
      ]
    },
    "configuration": {
      "title": "Inc0ming",
      "properties": {
        "inc0ming.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable date-based notifications for radar items"
        },
        "inc0ming.notifications.warningDays": {
          "type": "number",
          "default": 7,
          "description": "Days before a radar item date to show a warning notification"
        },
        "inc0ming.notifications.urgentDays": {
          "type": "number",
          "default": 1,
          "description": "Days before a radar item date to show an urgent notification"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.config.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npx mocha --ui tdd ./out/test/**/*.test.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "esbuild": "^0.27.3",
    "glob": "^10.0.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  }
}
