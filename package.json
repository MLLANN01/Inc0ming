{
  "name": "inc0ming",
  "displayName": "Inc0ming",
  "description": "Radar + Todo dashboard powered by markdown files",
  "version": "0.1.0",
  "publisher": "MLLANN01",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MLLANN01/Inc0ming"
  },
  "license": "ISC",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:inc0ming.md"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inc0ming",
          "title": "Inc0ming",
          "icon": "media/inc0ming-icon.svg"
        }
      ]
    },
    "views": {
      "inc0ming": [
        {
          "id": "inc0ming.statusView",
          "name": "Inc0ming",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "inc0ming.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addSwimlane",
        "title": "Add Swim Lane",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addRadarItem",
        "title": "Add Radar Item",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addTodo",
        "title": "Add Todo",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addTodoSection",
        "title": "Add Todo Section",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.editItem",
        "title": "Edit",
        "icon": "$(edit)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.deleteItem",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.toggleTodo",
        "title": "Toggle Complete",
        "icon": "$(check)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.addQuote",
        "title": "Add Quote",
        "icon": "$(add)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.editQuote",
        "title": "Edit Quote",
        "icon": "$(edit)",
        "category": "Inc0ming"
      },
      {
        "command": "inc0ming.deleteQuote",
        "title": "Delete Quote",
        "icon": "$(trash)",
        "category": "Inc0ming"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "inc0ming.openDashboard",
          "when": "view == inc0ming.statusView",
          "group": "navigation"
        },
        {
          "command": "inc0ming.refresh",
          "when": "view == inc0ming.statusView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Inc0ming",
      "properties": {
        "inc0ming.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable date-based notifications for radar items"
        },
        "inc0ming.notifications.warningDays": {
          "type": "number",
          "default": 7,
          "description": "Days before a radar item date to show a warning notification"
        },
        "inc0ming.notifications.urgentDays": {
          "type": "number",
          "default": 1,
          "description": "Days before a radar item date to show an urgent notification"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npx mocha --ui tdd ./out/test/**/*.test.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.0.0",
    "@types/mocha": "^10.0.0",
    "@types/glob": "^8.0.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.3.0",
    "mocha": "^10.2.0",
    "glob": "^10.0.0"
  }
}
